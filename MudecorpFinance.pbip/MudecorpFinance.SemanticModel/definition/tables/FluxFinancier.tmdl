table FluxFinancier
	lineageTag: 0ab063c9-0f01-4c5d-b24b-2ae044dc208f

	measure 'Total Revenus' = CALCULATE(SUM(FluxFinancier[Montant]), FluxFinancier[TypeFlux] = "REVENU", FluxFinancier[Statut] = "VALIDE")
		formatString: '$#,##0.00'
		displayFolder: Indicateurs
		lineageTag: 266504d1-abbd-4f5b-9374-1dee28d65ea3

	measure 'Total Dépenses' = CALCULATE(SUM(FluxFinancier[Montant]), FluxFinancier[TypeFlux] = "DEPENSE", FluxFinancier[Statut] = "VALIDE")
		formatString: '$#,##0.00'
		displayFolder: Indicateurs
		lineageTag: efd87e77-4017-41a8-a222-e1dc47b4897e

	measure 'Résultat Net' = [Total Revenus] - [Total Dépenses]
		formatString: '$#,##0.00'
		displayFolder: Indicateurs
		lineageTag: 314587d3-01ca-41c5-8b46-1556753fa49f

	measure 'Marge Nette %' = DIVIDE([Résultat Net], [Total Revenus], 0)
		formatString: '0.0%'
		displayFolder: Indicateurs
		lineageTag: d75fe53e-79a1-4bb7-8bce-5e826182dd13

	measure 'Nb Transactions' = COUNT(FluxFinancier[TxId])
		formatString: '#,##0'
		displayFolder: Indicateurs
		lineageTag: 953c5067-d9ce-4206-b461-b06a09308172

	measure 'Panier Moyen' = DIVIDE([Total Revenus], [Nb Transactions])
		formatString: '$#,##0.00'
		displayFolder: Indicateurs
		lineageTag: dceb2988-a1c3-46e9-86dd-cf403e89e78d

	measure 'Revenus Mois Précédent' = CALCULATE([Total Revenus], PREVIOUSMONTH(Calendrier[DateId]))
		formatString: '$#,##0.00'
		displayFolder: Indicateurs
		lineageTag: e3ff7574-2bed-438c-b636-43b78fe8af0e

	measure 'Variation Revenus %' = DIVIDE([Total Revenus] - [Revenus Mois Précédent], [Revenus Mois Précédent], 0)
		formatString: '0.0%;(0.0%)'
		displayFolder: Indicateurs
		lineageTag: 8a385d3a-22c5-42c3-985b-b3e57b7a8434

	column TxId
